ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5187
ConnectionStrings__DefaultConnection=Data Source=App_Data/inrfs-financer.db
Jwt__Key=replace-with-a-random-secret-of-at-least-32-characters
DataProtection__Key=replace-with-a-separate-random-encryption-key
Database__Initialize=true
SeedAdmin__Email=admin@example.invalid
SeedAdmin__Password=replace-with-a-strong-local-development-password
AuthDelivery__Provider=Webhook
AuthDelivery__WebhookUrl=https://approved-provider.example.invalid/auth-delivery
AuthDelivery__ApiKey=replace-with-provider-secret
AuthDelivery__PasswordResetUrl=https://portal.example.invalid/reset-password
# Development-only automated tests may set AuthDelivery__DevelopmentOutputPath.
SmsGateway__Provider=Webhook
SmsGateway__WebhookUrl=https://approved-provider.example.invalid/sms
SmsGateway__ApiKey=replace-with-provider-secret
