@baseUrl = http://localhost:5187/api/v1
@token = paste-access-token
@refreshToken = paste-refresh-token
@challengeId = 00000000-0000-0000-0000-000000000000
@financerId = 00000000-0000-0000-0000-000000000000
@userId = 00000000-0000-0000-0000-000000000000
@roleId = 00000000-0000-0000-0000-000000000000
@customerId = 00000000-0000-0000-0000-000000000000
@kycId = 00000000-0000-0000-0000-000000000000
@documentId = 00000000-0000-0000-0000-000000000000
@productId = 00000000-0000-0000-0000-000000000000
@applicationId = 00000000-0000-0000-0000-000000000000
@loanId = 00000000-0000-0000-0000-000000000000
@scheduleId = 00000000-0000-0000-0000-000000000000
@paymentId = 00000000-0000-0000-0000-000000000000
@transactionId = 00000000-0000-0000-0000-000000000000
@ticketId = 00000000-0000-0000-0000-000000000000
@invoiceId = 00000000-0000-0000-0000-000000000000
@planId = 00000000-0000-0000-0000-000000000000

### Health / Swagger
GET http://localhost:5187/health/live
###
GET http://localhost:5187/health/ready
###
GET http://localhost:5187/swagger/v1/swagger.json

### Authentication
POST {{baseUrl}}/auth/login
Content-Type: application/json

{"email":"admin@local.test","password":"StrongLocalPassword123!","portal":"admin"}
###
POST {{baseUrl}}/auth/otp/request
Content-Type: application/json

{"destination":"admin@local.test","purpose":"Login"}
###
POST {{baseUrl}}/auth/otp/verify
Content-Type: application/json

{"challengeId":"{{challengeId}}","code":"000000"}
###
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{"refreshToken":"{{refreshToken}}"}
###
POST {{baseUrl}}/auth/password/forgot
Content-Type: application/json

{"email":"admin@local.test"}
###
POST {{baseUrl}}/auth/password/reset
Content-Type: application/json

{"token":"paste-reset-token","newPassword":"NewStrongPassword123!","confirmPassword":"NewStrongPassword123!"}
###
GET {{baseUrl}}/auth/me
Authorization: Bearer {{token}}
###
POST {{baseUrl}}/auth/revoke
Authorization: Bearer {{token}}
Content-Type: application/json

{"refreshToken":"{{refreshToken}}"}

### Financers / users / roles
GET {{baseUrl}}/financers?page=1&pageSize=20&search=
Authorization: Bearer {{token}}
###
POST {{baseUrl}}/financers
Authorization: Bearer {{token}}
Content-Type: application/json

{"legalName":"Example Finance Private Limited","displayName":"Example Finance","ownerName":"Example Owner","email":"owner@example.test","phone":"+919876543210","addressLine":"1 Main Road","city":"Ahmedabad","state":"Gujarat","postalCode":"380001","taxNumber":"GSTINEXAMPLE","registrationNumber":"REG-EXAMPLE","serviceChargePercentage":1.0}
###
POST {{baseUrl}}/financers/{{financerId}}/status
Authorization: Bearer {{token}}
Content-Type: application/json

{"status":"Active","reason":"KYC and onboarding approved"}
###
GET {{baseUrl}}/financers/{{financerId}}/usage
Authorization: Bearer {{token}}
###
GET {{baseUrl}}/users?page=1&pageSize=20
Authorization: Bearer {{token}}
###
POST {{baseUrl}}/users
Authorization: Bearer {{token}}
Content-Type: application/json

{"financerId":"{{financerId}}","firstName":"Loan","lastName":"Officer","email":"officer@example.test","phone":"+919876543211","password":"StrongPassword123!","roleIds":["{{roleId}}"]}
###
PUT {{baseUrl}}/users/{{userId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{"firstName":"Updated","lastName":"Officer","phone":"+919876543211","status":"Active"}
###
PUT {{baseUrl}}/users/{{userId}}/roles
Authorization: Bearer {{token}}
Content-Type: application/json

["{{roleId}}"]
###
DELETE {{baseUrl}}/users/{{userId}}
Authorization: Bearer {{token}}
###
GET {{baseUrl}}/admins
Authorization: Bearer {{token}}
###
GET {{baseUrl}}/employees
Authorization: Bearer {{token}}
###
GET {{baseUrl}}/roles
Authorization: Bearer {{token}}
###
POST {{baseUrl}}/roles
Authorization: Bearer {{token}}
Content-Type: application/json

{"name":"CustomReviewer","description":"Custom review role","permissionIds":[]}

### Customers / KYC / documents
GET {{baseUrl}}/customers?page=1&pageSize=20&search=
Authorization: Bearer {{token}}
###
POST {{baseUrl}}/customers
Authorization: Bearer {{token}}
Content-Type: application/json

{"financerId":"{{financerId}}","fullName":"Ramesh Kumar","dateOfBirth":"1985-03-15","gender":"Male","phone":"+919800111111","email":"ramesh@example.test","addressLine1":"12 MG Road","addressLine2":"Andheri West","city":"Mumbai","state":"Maharashtra","postalCode":"400001","aadhaar":"123456789012","pan":"ABCDE1234F"}
###
GET {{baseUrl}}/customers/{{customerId}}
Authorization: Bearer {{token}}
###
PUT {{baseUrl}}/customers/{{customerId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{"fullName":"Ramesh Kumar","dateOfBirth":"1985-03-15","gender":"Male","phone":"+919800111111","email":"ramesh@example.test","addressLine1":"12 MG Road","addressLine2":"Andheri West","city":"Mumbai","state":"Maharashtra","postalCode":"400001","status":"Active"}
###
POST {{baseUrl}}/customers/{{customerId}}/notes
Authorization: Bearer {{token}}
Content-Type: application/json

{"text":"Customer supplied updated income evidence."}
###
GET {{baseUrl}}/customers/{{customerId}}/ledger
Authorization: Bearer {{token}}
###
GET {{baseUrl}}/kyc?status=Submitted
Authorization: Bearer {{token}}
###
POST {{baseUrl}}/kyc
Authorization: Bearer {{token}}
Content-Type: application/json

{"customerId":"{{customerId}}","identityType":"PAN","identityNumber":"ABCDE1234F","declaredName":"Ramesh Kumar","declaredDateOfBirth":"1985-03-15"}
###
POST {{baseUrl}}/kyc/{{kycId}}/decision
Authorization: Bearer {{token}}
Content-Type: application/json

{"status":"Verified","notes":"Document and identity matched."}
### Upload document (replace path)
POST {{baseUrl}}/documents
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="category"

PAN
--boundary
Content-Disposition: form-data; name="customerId"

{{customerId}}
--boundary
Content-Disposition: form-data; name="file"; filename="sample.pdf"
Content-Type: application/pdf

< ./sample.pdf
--boundary--
###
GET {{baseUrl}}/documents/{{documentId}}
Authorization: Bearer {{token}}
###
GET {{baseUrl}}/documents/{{documentId}}/content
Authorization: Bearer {{token}}
###
POST {{baseUrl}}/documents/{{documentId}}/verify
Authorization: Bearer {{token}}
Content-Type: application/json

{"status":"Verified","notes":"Readable and valid."}
###
DELETE {{baseUrl}}/documents/{{documentId}}
Authorization: Bearer {{token}}

### Products / eligibility / loan workflow
GET {{baseUrl}}/loan-products
Authorization: Bearer {{token}}
###
POST {{baseUrl}}/loan-products
Authorization: Bearer {{token}}
Content-Type: application/json

{"code":"PERSONAL12","name":"Personal Loan","minimumPrincipal":10000,"maximumPrincipal":500000,"minimumTenureMonths":3,"maximumTenureMonths":36,"annualInterestRate":18,"interestMethod":"ReducingBalance","repaymentFrequency":"Monthly","processingFeePercentage":1,"lateFeePercentage":2,"minimumAge":21,"maximumAgeAtMaturity":65,"maximumFoirPercentage":50,"isActive":true}
###
PUT {{baseUrl}}/loan-products/{{productId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{"code":"PERSONAL12","name":"Personal Loan","minimumPrincipal":10000,"maximumPrincipal":600000,"minimumTenureMonths":3,"maximumTenureMonths":36,"annualInterestRate":18,"interestMethod":"ReducingBalance","repaymentFrequency":"Monthly","processingFeePercentage":1,"lateFeePercentage":2,"minimumAge":21,"maximumAgeAtMaturity":65,"maximumFoirPercentage":50,"isActive":true}
###
POST {{baseUrl}}/eligibility/checks
Authorization: Bearer {{token}}
Content-Type: application/json

{"customerId":"{{customerId}}","loanProductId":"{{productId}}","requestedAmount":100000,"tenureMonths":12,"monthlyIncome":50000,"monthlyObligations":5000}
###
GET {{baseUrl}}/loan-applications?page=1&pageSize=20
Authorization: Bearer {{token}}
###
POST {{baseUrl}}/loan-applications
Authorization: Bearer {{token}}
Content-Type: application/json

{"customerId":"{{customerId}}","loanProductId":"{{productId}}","requestedPrincipal":100000,"requestedTenureMonths":12,"purpose":"Business working capital","monthlyIncome":50000,"monthlyObligations":5000}
###
GET {{baseUrl}}/loan-applications/{{applicationId}}
Authorization: Bearer {{token}}
###
GET {{baseUrl}}/loan-applications/{{applicationId}}/history
Authorization: Bearer {{token}}
###
POST {{baseUrl}}/loan-applications/{{applicationId}}/submit
Authorization: Bearer {{token}}
###
POST {{baseUrl}}/loan-applications/{{applicationId}}/verify
Authorization: Bearer {{token}}
###
POST {{baseUrl}}/loan-applications/{{applicationId}}/approve
Authorization: Bearer {{token}}
Content-Type: application/json

{"approvedPrincipal":100000,"approvedAnnualRate":18,"approvedTenureMonths":12,"notes":"Approved within policy."}
###
POST {{baseUrl}}/loan-applications/{{applicationId}}/reject
Authorization: Bearer {{token}}
Content-Type: application/json

{"reasonCode":"POLICY","notes":"Application does not meet policy."}
###
POST {{baseUrl}}/loan-applications/{{applicationId}}/disburse
Authorization: Bearer {{token}}
Content-Type: application/json

{"amount":100000,"disbursementDate":"2026-08-12","mode":"BankTransfer","bankReference":"UTR-EXAMPLE-001"}
